# Questi file vengono eseguiti o letti da Linux: devono avere terminazioni LF
# comunque siano configurati git e l'editor su Windows. Uno script con CRLF
# muore sul server con "bad interpreter", e i \r finirebbero dentro la
# configurazione di Apache e l'unità systemd generate.
*.sh        text eol=lf
*.template  text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
*.mjs       text eol=lf

# Le immagini non sono testo: git non deve toccarle.
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.ico  binary
