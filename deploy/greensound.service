# Keeps the API running and restarts it on boot or after a crash.
#
#   sudo cp deploy/greensound.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now greensound
#   sudo systemctl status greensound
#   journalctl -u greensound -f        # live logs

[Unit]
Description=Greensound API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/greensound

Environment=NODE_ENV=production
Environment=PORT=3001
# One Apache in front, so trust exactly one hop of X-Forwarded-For.
Environment=TRUST_PROXY=1
Environment=DATABASE_PATH=/var/www/greensound/data/greensound.db
Environment=UPLOAD_DIR=/var/www/greensound/data/uploads

ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

# Listens only on loopback; Apache is the only thing that talks to it.
# Hardening: the process needs to write to data/ and read the rest.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/greensound/data

StandardOutput=journal
StandardError=journal
SyslogIdentifier=greensound

[Install]
WantedBy=multi-user.target
