# Copy to .env and adjust. Nothing here is required to run locally —
# every value below has a sensible default.

# --- Server ---------------------------------------------------------------
# Port the API (and, in production, the site itself) listens on.
PORT=3001

# Set to "production" on the server. Among other things this makes the session
# cookie Secure, so it is only ever sent over HTTPS.
NODE_ENV=development

# Number of reverse proxies in front of the app (nginx, Caddy, Cloudflare…).
# Needed so the login rate-limiter sees the real client IP. 0 if no proxy.
TRUST_PROXY=1

# --- Storage --------------------------------------------------------------
# SQLite file and upload directory. Point these at a persistent volume — this
# is the entire site's content.
DATABASE_PATH=./data/greensound.db
UPLOAD_DIR=./data/uploads

# --- Frontend -------------------------------------------------------------
# Only set this if the API is served from a different origin than the site.
# Leave it empty for the normal single-origin setup.
# VITE_API_URL=https://api.example.com
